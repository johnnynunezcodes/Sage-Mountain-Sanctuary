# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# saved "complete webpage" downloads (e.g. browser Save As > Webpage,
# Complete). These bundle third-party JS/HTML from whatever site you were
# viewing and can silently leak that site's API keys if committed - see the
# GitHub secret-scanning incident from the "Harriet 2"/"Francine" saves.
# Keep them out of the repo entirely.
*_files/
public/images/**/*.html
*.mhtml
~$*

